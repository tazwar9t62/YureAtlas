  "devDependencies": {
    "typescript": "^5.9.3", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0", "@types/geojson": "^7946.0.16",
    "@playwright/test": "1.63.0", "openapi-typescript": "7.13.0"
  }
